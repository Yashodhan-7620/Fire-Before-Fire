FROM python:3.11-slim

WORKDIR /app

# git is needed at runtime by the webapp's auto-retrain pipeline
# (src/monitoring/retrain.py best-effort commits + pushes updated
# dvc.lock / baseline files after retraining).
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi uvicorn[standard] pydantic pandas pyarrow scikit-learn mlflow requests \
    scipy jinja2 python-multipart prometheus-client apscheduler shap dvc

COPY src/ src/
COPY data/ data/

ENV PYTHONUNBUFFERED=1

# Default: run the ingestion API. Override CMD to run predict_api or
# stream_monitor in other containers (see docker-compose.yml).
CMD ["uvicorn", "src.ingestion.api:app", "--host", "0.0.0.0", "--port", "8000"]
